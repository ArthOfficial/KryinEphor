# EduNex Environment Variables — Template
# Copy this file to PRIVATE/.env and fill in your real values.
# NEVER commit actual keys to the repository.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Optional Web Push. Generate a VAPID pair; keep the private key in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
